# ── Twilio ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Google Calendar ───────────────────────────────────────────────────────────
# Calendar ID from Google Calendar settings (looks like an email address)
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ── Stylist Profile ───────────────────────────────────────────────────────────
STYLIST_NAME=Sarah
SALON_NAME=Sarah's Salon
SALON_ADDRESS=123 Main St, Your City, ST 00000
STYLIST_PHONE=+15551234567

# ── Booking Settings ──────────────────────────────────────────────────────────
BOOKING_SLOT_MINUTES=30
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
BOOKING_DAYS_AHEAD=14

# ── App ───────────────────────────────────────────────────────────────────────
DATABASE_PATH=hair_stylist.db
SECRET_KEY=change-me-to-a-random-string
PORT=5000
DEBUG=false
